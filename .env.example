# Local development defaults. Copy to .env if overriding these values.
ENVIRONMENT=development
APP_PORT=8000
PUBLIC_URL=http://localhost:8000
COOKIE_SECURE=false
# Empty in development generates an ephemeral signing key at startup.
# Set a randomly generated secret of at least 32 characters for production.
JWT_SECRET=
# Compose uses PostgreSQL automatically; direct Python development uses SQLite.
# DATABASE_URL=postgresql+psycopg://attendance:CHANGE_ME@localhost:5432/attendance
POSTGRES_PASSWORD=local-development-only
# On a fresh database, set both to create an initial admin instead of demo seeding.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=